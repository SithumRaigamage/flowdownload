{
  "manifest_version": 3,
  "name": "FlowDownload",
  "version": "1.0",
  "description": "Send downloads to FlowDownload for reliable, resumable downloading.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "downloads",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlowDownload"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
